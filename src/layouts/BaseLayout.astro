---
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { localizedPath, t, type Locale } from "../i18n";

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  canonical?: string;
  robots?: string;
  image?: string;
  pagefindIgnore?: boolean;
}

const {
  title,
  description,
  lang = "en",
  canonical,
  robots,
  image,
  pagefindIgnore = false,
} = Astro.props;
const pagePath = Astro.url.pathname;
const siteOrigin = Astro.site ?? Astro.url;
const locales: Locale[] = ["en", "fr", "rw"];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={title}
      description={description}
      lang={lang}
      canonical={canonical}
      robots={robots}
      image={image}
    >
      <slot name="hreflang" slot="hreflang" />
    </SEO>
    {
      locales.map((locale) => (
        <link
          rel="alternate"
          hreflang={locale}
          href={new URL(localizedPath(pagePath, locale), siteOrigin).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizedPath(pagePath, "en"), siteOrigin).href}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {t("skipMain", lang)}
    </a>
    <Header lang={lang} />
    {
      lang !== "en" && (
        <p class="translation-review-notice" role="note">
          {t("translationReviewNotice", lang)}
        </p>
      )
    }
    <main
      id="main-content"
      tabindex="-1"
      data-pagefind-body
      data-pagefind-ignore={pagefindIgnore ? true : undefined}
    >
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
