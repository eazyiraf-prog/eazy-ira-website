---
import Container from "./ui/Container.astro";
import Checkbox from "./forms/Checkbox.astro";
import EmailField from "./forms/EmailField.astro";
import FormShell from "./forms/FormShell.astro";
import impact from "../data/impact.json";
import nav from "../data/nav.json";
import site from "../data/site.json";
import { localizedPath, t, type Locale } from "../i18n";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
---

<footer class="site-footer">
  <Container wide>
    <div class="site-footer__main">
      <div class="site-footer__identity">
        <a class="site-footer__brand" href={localizedPath("/", lang)}>
          {site.name}
        </a>
        <p>{site.tagline}</p>
        <p>{site.location}</p>
        <ul class="site-socials" aria-label={t("footerSocial", lang)}>
          {Object.entries(site.socials).map(([platform, contact]) => (
            <li>
              <span>
                {platform}:{" "}
                {contact.needsConfirmation
                  ? t("linkToConfirm", lang)
                  : contact.value}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <nav class="site-footer__sitemap" aria-label={t("footerNavigation", lang)}>
        <h2>{t("explore", lang)}</h2>
        <ul>
          {nav.primary.map((item) => (
            <li>
              <a href={localizedPath(item.href, lang)}>{t(item.labelKey, lang)}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="site-footer__signup">
        <h2>{t("stayConnected", lang)}</h2>
        <p>{t("newsletterIntro", lang)}</p>
        <FormShell name="newsletter" submitLabel={t("signUp", lang)} lang={lang}>
          <EmailField
            id="newsletter-email"
            name="email"
            label={t("emailAddress", lang)}
            hint={t("newsletterHint", lang)}
            lang={lang}
            required
          />
          <Checkbox
            id="newsletter-consent"
            name="consent"
            hint={t("unsubscribeHint", lang)}
            lang={lang}
            required
          >
            {t("newsletterConsent", lang)}{" "}
            <a href={localizedPath("/legal/privacy", lang)}>{t("privacyPolicy", lang)}</a>.
          </Checkbox>
        </FormShell>
      </div>

      <div class="site-footer__details">
        <h2>{t("organizationDetails", lang)}</h2>
        <p>
          {t("registrationDetails", lang)}{" "}
          {site.registrationDetails.needsConfirmation
            ? t("toBeConfirmed", lang)
            : site.registrationDetails.value}
        </p>
        <p>
          {t("lastUpdated", lang)}{" "}
          {impact.lastUpdated.needsConfirmation
            ? t("dateToBeConfirmed", lang)
            : impact.lastUpdated.value}
        </p>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {site.name}</p>
      <nav aria-label={t("legalLinks", lang)}>
        <ul>
          {nav.legal.map((item) => (
            <li>
              <a href={localizedPath(item.href, lang)}>{t(item.labelKey, lang)}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </Container>
</footer>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>
