---
import Container from "./ui/Container.astro";
import Checkbox from "./forms/Checkbox.astro";
import EmailField from "./forms/EmailField.astro";
import FormShell from "./forms/FormShell.astro";
import impact from "../data/impact.json";
import nav from "../data/nav.json";
import site from "../data/site.json";
---

<footer class="site-footer">
  <Container wide>
    <div class="site-footer__main">
      <div class="site-footer__identity">
        <a class="site-footer__brand" href="/">
          {site.name}
        </a>
        <p>{site.tagline}</p>
        <p>{site.location}</p>
        <ul class="site-socials" aria-label="Social media">
          {Object.entries(site.socials).map(([platform, contact]) => (
            <li>
              <span>
                {platform}:{" "}
                {contact.needsConfirmation
                  ? "link to be confirmed"
                  : contact.value}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <nav class="site-footer__sitemap" aria-label="Footer navigation">
        <h2>Explore</h2>
        <ul>
          {nav.primary.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="site-footer__signup">
        <h2>Stay connected</h2>
        <p>Sign up for occasional foundation updates.</p>
        <FormShell name="newsletter" submitLabel="Sign up">
          <EmailField
            id="newsletter-email"
            name="email"
            label="Email address"
            hint="We will use this address to send occasional foundation updates."
            required
          />
          <Checkbox
            id="newsletter-consent"
            name="consent"
            hint="You can unsubscribe from updates at any time."
            required
          >
            I agree to receive updates. Read our
            <a href="/legal/privacy">Privacy Policy</a>.
          </Checkbox>
        </FormShell>
      </div>

      <div class="site-footer__details">
        <h2>Organization details</h2>
        <p>
          Registration details:{" "}
          {site.registrationDetails.needsConfirmation
            ? "to be confirmed"
            : site.registrationDetails.value}
        </p>
        <p>
          Last updated:{" "}
          {impact.lastUpdated.needsConfirmation
            ? "date to be confirmed"
            : impact.lastUpdated.value}
        </p>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {site.name}</p>
      <nav aria-label="Legal links">
        <ul>
          {nav.legal.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </Container>
</footer>
