---
import Card from "./ui/Card.astro";

interface Counter {
  value: number | null;
  label: string;
  needsConfirmation: boolean;
}

interface Props {
  counters: Counter[];
}

const { counters } = Astro.props;
---

<ul class="impact-counter-grid">
  {counters.map((counter) => (
    <li>
      <Card class="impact-counter-card">
        <p class="impact-counter-card__label">{counter.label}</p>
        <p class="impact-counter-card__value">
          {counter.value === null ? "[to be confirmed]" : (
            <span data-count-up data-target={counter.value}>
              {counter.value}
            </span>
          )}
        </p>
        {counter.needsConfirmation && (
          <span class="impact-counter-confirmation">Needs confirmation</span>
        )}
      </Card>
    </li>
  ))}
</ul>

<style>
  .impact-counter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .impact-counter-card__label {
    color: var(--text-muted);
    font-size: var(--type-sm);
  }

  .impact-counter-card__value {
    margin-top: 0.75rem;
    color: var(--brand-primary);
    font-family: var(--font-display);
    font-size: var(--type-2xl);
    font-weight: 600;
    line-height: 1.1;
  }

  .impact-counter-confirmation {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: var(--type-xs);
    font-weight: 600;
  }
</style>
