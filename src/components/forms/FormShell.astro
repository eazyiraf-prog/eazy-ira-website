---
import Button from "../ui/Button.astro";
import site from "../../data/site.json";
import { t, type Locale } from "../../i18n";

interface Props {
  name: string;
  submitLabel?: string;
  class?: string;
  lang?: Locale;
}

const { name, submitLabel, class: className, lang = "en" } = Astro.props;
const contactEmail = site.email.value ?? "[to be confirmed]";
---

<form
  name={name}
  method="POST"
  action={`/api/forms/${name}`}
  data-form-endpoint
  class:list={["form-shell", className]}
>
  <div class="form-honeypot" aria-hidden="true" inert>
    <label>
      {t("formLeaveEmpty", lang)}
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <slot />
  <input type="hidden" name="contact-email" value={contactEmail} />
  <div
    class="cf-turnstile"
    data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
    data-appearance="interaction-only"
  ></div>
  <p
    class="form-submit-error"
    role="alert"
    data-submit-error
    data-error-message={t("formSubmitError", lang)}
    hidden
  >
    {t("formSubmitError", lang)}
  </p>
  <Button type="submit" variant="primary">{submitLabel ?? t("send", lang)}</Button>
</form>

<script>
  import "../../scripts/forms.js";
</script>
