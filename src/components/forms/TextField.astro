---
import { t, type Locale } from "../../i18n";

interface Props {
  id: string;
  name: string;
  label: string;
  hint: string;
  type?: "text" | "tel";
  required?: boolean;
  autocomplete?: string;
  lang?: Locale;
}

const {
  id,
  name,
  label,
  hint,
  type = "text",
  required = false,
  autocomplete,
  lang = "en",
} = Astro.props;
---

<div class="form-field">
  <label for={id}>
    {label}
    {required && <span class="form-required" aria-hidden="true">*</span>}
    {required && <span class="form-visually-hidden"> {t("formRequired", lang)}</span>}
  </label>
  <input
    id={id}
    name={name}
    type={type}
    required={required}
    autocomplete={autocomplete}
    aria-describedby={`${id}-hint ${id}-error`}
    data-error-id={`${id}-error`}
    data-required-error={t("formRequiredError", lang)}
    data-type-error={t("formEmailError", lang)}
    data-generic-error={t("formGenericError", lang)}
  />
  <span class="form-hint" id={`${id}-hint`}>{hint}</span>
  <span class="form-error" id={`${id}-error`} hidden></span>
</div>
