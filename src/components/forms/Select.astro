---
import { t, type Locale } from "../../i18n";

interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  name: string;
  label: string;
  hint: string;
  options: Option[];
  required?: boolean;
  lang?: Locale;
}

const { id, name, label, hint, options, required = false, lang = "en" } = Astro.props;
---

<div class="form-field">
  <label for={id}>
    {label}
    {required && <span class="form-required" aria-hidden="true">*</span>}
    {required && <span class="form-visually-hidden"> {t("formRequired", lang)}</span>}
  </label>
  <select
    id={id}
    name={name}
    required={required}
    aria-describedby={`${id}-hint ${id}-error`}
    data-error-id={`${id}-error`}
    data-required-error={t("formRequiredError", lang)}
    data-type-error={t("formEmailError", lang)}
    data-generic-error={t("formGenericError", lang)}
  >
    <option value="">{t("formChooseOption", lang)}</option>
    {options.map((option) => (
      <option value={option.value}>{option.label}</option>
    ))}
  </select>
  <span class="form-hint" id={`${id}-hint`}>{hint}</span>
  <span class="form-error" id={`${id}-error`} hidden></span>
</div>
