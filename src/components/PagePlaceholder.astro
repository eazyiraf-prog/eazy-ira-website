---
import Container from "./ui/Container.astro";
import { t, type Locale } from "../i18n";

interface Props {
  title: string;
  lang?: Locale;
}

const { title, lang = "en" } = Astro.props;
---

<section class="page-placeholder">
  <Container>
    <h1>{title}</h1>
    <p>{t("pageBeingPrepared", lang)}</p>
  </Container>
</section>
