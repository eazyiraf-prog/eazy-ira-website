---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<form id={`${id}-form`} class="site-search" action="/search" role="search">
  <label class="form-visually-hidden" for={id}>Search this site</label>
  <input
    id={id}
    name="q"
    type="search"
    placeholder="Search"
    enterkeyhint="search"
  />
  <button type="submit">Search</button>
</form>
