---
type Variant = "primary" | "secondary" | "ghost" | "donate";

interface Props {
  variant?: Variant;
  analyticsEvent?: "donate" | "partner" | "volunteer";
  href?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  class?: string;
  target?: string;
  rel?: string;
}

const {
  variant = "primary",
  analyticsEvent,
  href,
  type = "button",
  disabled = false,
  class: className,
  target,
  rel,
} = Astro.props;
const classes = ["ui-button", `ui-button--${variant}`, className];
---

{href ? (
  <a
    href={href}
    target={target}
    rel={rel}
    data-analytics-event={analyticsEvent}
    class:list={classes}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    disabled={disabled}
    data-analytics-event={analyticsEvent}
    class:list={classes}
  >
    <slot />
  </button>
)}
