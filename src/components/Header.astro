---
import DonationButton from "./DonationButton.astro";
import SiteSearch from "./SiteSearch.astro";
import Container from "./ui/Container.astro";
import nav from "../data/nav.json";
import site from "../data/site.json";
import { localizedPath, t, type Locale } from "../i18n";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
---

<header class="site-header" data-site-header>
  <Container wide>
    <div class="site-header__inner">
      <a class="site-brand" href={localizedPath("/", lang)}>
        <span class="site-brand__mark" aria-hidden="true">
          E
        </span>
        <span class="site-brand__name">{site.name}</span>
      </a>
      <button
        class="site-menu-toggle"
        type="button"
        aria-controls="primary-navigation"
        aria-expanded="false"
        aria-label={t("openNavigation", lang)}
        data-menu-toggle
        data-open-label={t("openNavigation", lang)}
        data-close-label={t("closeNavigation", lang)}
        data-menu-text={t("menu", lang)}
        data-close-text={t("close", lang)}
      >
        <span data-menu-label>{t("menu", lang)}</span>
        <span class="site-menu-toggle__icon" aria-hidden="true">
          ☰
        </span>
      </button>
      <nav
        class="site-navigation"
        id="primary-navigation"
        aria-label={t("mainNavigation", lang)}
      >
        <ul>
          {nav.primary.map((item) => (
            <li>
              <a
                href={localizedPath(item.href, lang)}
                aria-current={
                  Astro.url.pathname === localizedPath(item.href, lang) ? "page" : undefined
                }
              >
                {t(item.labelKey, lang)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <SiteSearch id="header-search" lang={lang} />
      <div class="site-header__actions">
        <div
          class="language-switcher"
          role="group"
          aria-label={t("languageOptions", lang)}
        >
          {(["en", "fr", "rw"] as const).map((language) => (
            <a
              href={localizedPath(Astro.url.pathname, language as Locale)}
              data-language-link
              lang={language}
              hreflang={language}
              data-language={language}
              aria-current={lang === language ? "page" : undefined}
              class:list={[
                "language-switcher__option",
                lang === language && "is-current",
              ]}
            >
              {t(
                language === "en"
                  ? "languageEnglish"
                  : language === "fr"
                    ? "languageFrench"
                    : "languageKinyarwanda",
                lang,
              )}
            </a>
          ))}
        </div>
        <DonationButton lang={lang} />
      </div>
    </div>
  </Container>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const navigation = header?.querySelector<HTMLElement>("#primary-navigation");
  const menuLabel = header?.querySelector<HTMLElement>("[data-menu-label]");
  const mobileViewport = window.matchMedia("(max-width: 63.99rem)");

  if (header && toggle && navigation && menuLabel) {
    document.documentElement.dataset.js = "true";

    const setMenuOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        open ? toggle.dataset.closeLabel : toggle.dataset.openLabel,
      );
      navigation.dataset.open = String(open);
      menuLabel.textContent = open ? toggle.dataset.closeText ?? "" : toggle.dataset.menuText ?? "";

      if (open) {
        navigation.querySelector<HTMLAnchorElement>("a")?.focus();
      } else {
        toggle.focus();
      }
    };

    toggle.addEventListener("click", () => {
      setMenuOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    navigation.addEventListener("click", (event) => {
      if (
        (event.target as HTMLElement).closest("a") &&
        mobileViewport.matches
      ) {
        setMenuOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (toggle.getAttribute("aria-expanded") !== "true") return;

      if (event.key === "Escape") {
        event.preventDefault();
        setMenuOpen(false);
        return;
      }

      if (event.key !== "Tab") return;

      const focusable = Array.from(
        header.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((element) => element.getClientRects().length > 0);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (!first || !last) return;
      if (
        event.shiftKey &&
        (document.activeElement === first ||
          !header.contains(document.activeElement))
      ) {
        event.preventDefault();
        last.focus();
      } else if (
        !event.shiftKey &&
        (document.activeElement === last ||
          !header.contains(document.activeElement))
      ) {
        event.preventDefault();
        first.focus();
      }
    });

    mobileViewport.addEventListener("change", (event) => {
      if (!event.matches && toggle.getAttribute("aria-expanded") === "true") {
        setMenuOpen(false);
      }
    });
  }

  const preferredLanguage = window.localStorage.getItem("eazy-ira-language");
  if (preferredLanguage) {
    document
      .querySelector<HTMLAnchorElement>(
        `[data-language="${preferredLanguage}"]`,
      )
      ?.classList.add("is-remembered");
  }

  document
    .querySelectorAll<HTMLAnchorElement>(".language-switcher [data-language-link]")
    .forEach((link) => {
      link.addEventListener("click", () => {
        window.localStorage.setItem("eazy-ira-language", link.lang);
      });
    });
</script>
