---
import Button from "./ui/Button.astro";
import site from "../data/site.json";
import { localizedPath, t, type Locale } from "../i18n";

interface Props {
  label?: string;
  lang?: Locale;
}

const { label, lang = "en" } = Astro.props;
const fundraiser = site.donation.methods.find(
  (method) => method.id === "online-fundraiser",
);
const opensInNewTab = fundraiser?.enabled === true;
const href =
  opensInNewTab && fundraiser?.type === "link" && fundraiser.url
    ? fundraiser.url
    : localizedPath("/donate", lang);
---

<Button
  variant="donate"
  href={href}
  target={opensInNewTab ? "_blank" : undefined}
  rel={opensInNewTab ? "noopener noreferrer" : undefined}
>
  {label ?? t("donate", lang)}
  {opensInNewTab && <span class="visually-hidden"> {t("opensNewTab", lang)}</span>}
</Button>
