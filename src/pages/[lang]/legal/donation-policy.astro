---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DonationPolicyContent from "../../../components/legal/DonationPolicyContent.astro";
import LegalEnglishNotice from "../../../components/legal/LegalEnglishNotice.astro";
import { localizedPath, type Locale } from "../../../i18n";

export function getStaticPaths() {
  return ["fr", "rw"].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<BaseLayout
  title="Donation Policy"
  description="Draft information about how gifts to EAZY-IRA Charity Foundation are received and reported."
  lang={lang}
  canonical={new URL(localizedPath("/legal/donation-policy", "en"), Astro.site ?? Astro.url).href}
  pagefindIgnore
>
  <LegalEnglishNotice lang={lang} />
  <DonationPolicyContent lang={lang} />
</BaseLayout>
