---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DonationContent from "../../components/DonationContent.astro";
import { t, type Locale } from "../../i18n";

export function getStaticPaths() {
  return ["fr", "rw"].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<BaseLayout
  title={t("donateTitle", lang)}
  description={t("donateDescription", lang)}
  lang={lang}
>
  <DonationContent lang={lang} />
</BaseLayout>
