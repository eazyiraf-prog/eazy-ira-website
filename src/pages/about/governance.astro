---
import AboutPage from "../../components/AboutPage.astro";
import Card from "../../components/ui/Card.astro";
import Section from "../../components/ui/Section.astro";
---

<AboutPage
  title="Governance"
  description="Governance information for EAZY-IRA Charity Foundation."
  activePath="/about/governance"
>
  <Section
    eyebrow="Accountability"
    heading="Governance information"
    intro="We will publish verified organizational and governance details when they are supplied."
  >
    <Card>
      <dl class="governance-details">
        <div>
          <dt>Registration status</dt>
          <dd>[to be supplied]</dd>
        </div>
        <div>
          <dt>Legal name</dt>
          <dd>[to be supplied]</dd>
        </div>
        <div>
          <dt>Registration number</dt>
          <dd>[to be supplied]</dd>
        </div>
        <div>
          <dt>Leadership structure</dt>
          <dd>[to be supplied]</dd>
        </div>
      </dl>
    </Card>
  </Section>
</AboutPage>

<style>
  .governance-details {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .governance-details > div {
    display: grid;
    grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 1fr);
    gap: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1rem;
  }

  .governance-details > div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .governance-details dt {
    font-weight: 700;
  }

  .governance-details dd {
    margin: 0;
    color: var(--text-muted);
  }

  @media (max-width: 30rem) {
    .governance-details > div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
