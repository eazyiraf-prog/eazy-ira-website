---
import AboutPage from "../../components/AboutPage.astro";
import Section from "../../components/ui/Section.astro";
import SafeguardingPolicy from "../../components/SafeguardingPolicy.astro";
---

<AboutPage
  title="Safeguarding"
  description="Our child safeguarding commitment and reporting contact."
  activePath="/about/safeguarding"
>
  <Section eyebrow="Safeguarding" heading="Children's safety and dignity come first">
    <div class="safeguarding-copy"><SafeguardingPolicy /></div>
  </Section>
</AboutPage>

<style>
  .safeguarding-copy {
    display: grid;
    max-width: 52rem;
    gap: 1.25rem;
  }

  .safeguarding-copy :global(section) { display: grid; gap: 1rem; }
  .safeguarding-copy :global(h2) { font-size: var(--type-2xl); }
  .safeguarding-copy :global(h3) { font-size: var(--type-lg); }
  .safeguarding-copy :global(ol) { display: grid; gap: 0.75rem; padding-inline-start: 1.5rem; }
</style>
