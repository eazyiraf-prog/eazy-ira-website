---
import BaseLayout from "../layouts/BaseLayout.astro";
import Checkbox from "../components/forms/Checkbox.astro";
import EmailField from "../components/forms/EmailField.astro";
import FormShell from "../components/forms/FormShell.astro";
import TextArea from "../components/forms/TextArea.astro";
import TextField from "../components/forms/TextField.astro";
import Section from "../components/ui/Section.astro";
import { t } from "../i18n";
---

<BaseLayout
  title={t("prayWithUs")}
  description="Share a prayer request or become a prayer partner with EAZY-IRA Charity Foundation."
>
  <Section
    eyebrow="Prayer and encouragement"
    heading="Pray with us"
    intro="You can share a prayer request with the team or let us know that you would like to pray alongside the Foundation."
    headingLevel="h1"
  >
    <p class="prayer-safety-note">
      Please do not include children's names or any information that could
      identify a child in your request.
    </p>
  </Section>

  <Section eyebrow="Share with the prayer team" heading="Prayer request">
    <FormShell name="prayer-request" submitLabel={t("sendPrayerRequest")}>
      <TextField
        id="prayer-first-name"
        name="first-name"
        label={t("fieldFirstNameOptional")}
        hint={t("prayerLeaveBlankHint")}
        autocomplete="given-name"
      />
      <TextArea
        id="prayer-request-text"
        name="request"
        label={t("fieldPrayerRequest")}
        hint={t("prayerRequestHint")}
        required
      />
      <Checkbox
        id="prayer-private"
        name="private-to-prayer-team"
        hint={t("prayerTeamOnlyHint")}
        checked
      >
        {t("prayerTeamOnlyLabel")}
      </Checkbox>
      <EmailField
        id="prayer-email"
        name="email"
        label={t("fieldEmailReplyOptional")}
        hint={t("replyEmailHint")}
      />
      <Checkbox
        id="prayer-consent"
        name="consent"
        hint={t("prayerConsentHint")}
        required
      >
        {t("prayerConsentIntro")}{" "}
        <a href="/legal/privacy">{t("privacyPolicy")}</a>.
      </Checkbox>
    </FormShell>
  </Section>

  <Section eyebrow="Join us in prayer" heading="Prayer partner">
    <p class="prayer-partner-intro">
      Let us know you would like to be a prayer partner. An email address is
      optional if you would like the team to follow up.
    </p>
    <FormShell
      name="prayer-partner"
      submitLabel={t("signUpPrayerPartner")}
    >
      <Checkbox
        id="prayer-partner-opt-in"
        name="prayer-partner-opt-in"
        hint={t("prayerPartnerOptInHint")}
        required
      >
        {t("prayerPartnerOptInLabel")}
      </Checkbox>
      <EmailField
        id="prayer-partner-email"
        name="email"
        label={t("fieldEmailOptional")}
        hint={t("prayerPartnerEmailHint")}
      />
      <Checkbox
        id="prayer-partner-consent"
        name="consent"
        hint={t("prayerPartnerConsentHint")}
        required
      >
        {t("prayerConsentIntro")}{" "}
        <a href="/legal/privacy">{t("privacyPolicy")}</a>.
      </Checkbox>
    </FormShell>
  </Section>
</BaseLayout>
