---
import BaseLayout from "../layouts/BaseLayout.astro";
import Checkbox from "../components/forms/Checkbox.astro";
import EmailField from "../components/forms/EmailField.astro";
import FormShell from "../components/forms/FormShell.astro";
import Select from "../components/forms/Select.astro";
import TextArea from "../components/forms/TextArea.astro";
import TextField from "../components/forms/TextField.astro";
import Section from "../components/ui/Section.astro";
import { t } from "../i18n";

const roles = [
  { labelKey: "roleMentors", originalLabel: "Mentors" },
  { labelKey: "roleTeachers", originalLabel: "Teachers" },
  { labelKey: "roleMealHelpers", originalLabel: "Cooks and meal helpers" },
  { labelKey: "roleEventHelpers", originalLabel: "Event helpers" },
  { labelKey: "roleMedia", originalLabel: "Media and photography" },
  { labelKey: "roleProfessionalSkills", originalLabel: "Professional skills" },
];
---

<BaseLayout
  title="Volunteer"
  description="Explore volunteer roles with EAZY-IRA Charity Foundation."
>
  <Section
    eyebrow="Share your time and skills"
    heading="Volunteer with us"
    intro="Volunteers can support the Foundation in a range of practical and professional roles."
    headingLevel="h1"
  >
    <ul class="volunteer-role-list">
      {roles.map((role) => <li>{t(role.labelKey)}</li>)}
    </ul>
    <p class="safeguarding-note">
      All volunteers who work with children agree to our
      <a href="/about/safeguarding">Child Safeguarding commitment</a> and may
      be asked to complete a screening step before working with children.
    </p>
  </Section>

  <Section eyebrow="Apply to volunteer" heading="Volunteer application">
    <FormShell
      name="volunteer-application"
      submitLabel={t("sendApplication")}
    >
      <TextField
        id="volunteer-name"
        name="full-name"
        label={t("fieldFullName")}
        hint={t("contactNameHint")}
        autocomplete="name"
        required
      />
      <EmailField
        id="volunteer-email"
        name="email"
        label={t("fieldEmail")}
        hint={t("volunteerEmailHint")}
        required
      />
      <TextField
        id="volunteer-phone"
        name="phone"
        label={t("fieldPhone")}
        hint={t("volunteerPhoneHint")}
        type="tel"
        autocomplete="tel"
        required
      />
      <Select
        id="volunteer-role"
        name="role-interest"
        label={t("fieldRoleInterest")}
        hint={t("volunteerRoleHint")}
        required
        options={roles.map((role) => ({
          value: role.originalLabel.toLowerCase().replaceAll(" ", "-"),
          label: t(role.labelKey),
        }))}
      />
      <TextField
        id="volunteer-availability"
        name="availability"
        label={t("fieldAvailability")}
        hint={t("volunteerAvailabilityHint")}
        required
      />
      <TextArea
        id="volunteer-message"
        name="message"
        label={t("fieldShortMessage")}
        hint={t("volunteerMessageHint")}
        required
      />
      <Checkbox
        id="volunteer-consent"
        name="consent"
        hint={t("volunteerConsentHint")}
        required
      >
        {t("volunteerConsentIntro")}{" "}
        <a href="/legal/privacy">{t("privacyPolicy")}</a>.
      </Checkbox>
    </FormShell>
  </Section>
</BaseLayout>
