---
import BaseLayout from "../layouts/BaseLayout.astro";
import Checkbox from "../components/forms/Checkbox.astro";
import EmailField from "../components/forms/EmailField.astro";
import FormShell from "../components/forms/FormShell.astro";
import Select from "../components/forms/Select.astro";
import TextArea from "../components/forms/TextArea.astro";
import TextField from "../components/forms/TextField.astro";
import Section from "../components/ui/Section.astro";

const roles = [
  "Mentors",
  "Teachers",
  "Cooks and meal helpers",
  "Event helpers",
  "Media and photography",
  "Professional skills",
];
---

<BaseLayout
  title="Volunteer"
  description="Explore volunteer roles with EAZY-IRA Charity Foundation."
>
  <Section
    eyebrow="Share your time and skills"
    heading="Volunteer with us"
    intro="Volunteers can support the Foundation in a range of practical and professional roles."
  >
    <ul class="volunteer-role-list">
      {roles.map((role) => <li>{role}</li>)}
    </ul>
    <p class="safeguarding-note">
      All volunteers who work with children agree to our
      <a href="/about/safeguarding">Child Safeguarding commitment</a> and may
      be asked to complete a screening step before working with children.
    </p>
  </Section>

  <Section eyebrow="Apply to volunteer" heading="Volunteer application">
    <FormShell name="volunteer-application" submitLabel="Send application">
      <TextField
        id="volunteer-name"
        name="full-name"
        label="Full name"
        hint="Enter your name."
        autocomplete="name"
        required
      />
      <EmailField
        id="volunteer-email"
        name="email"
        label="Email"
        hint="We will use this to follow up about your application."
        required
      />
      <TextField
        id="volunteer-phone"
        name="phone"
        label="Phone"
        hint="Include a country code."
        type="tel"
        autocomplete="tel"
        required
      />
      <Select
        id="volunteer-role"
        name="role-interest"
        label="Role interest"
        hint="Choose the role you are most interested in."
        required
        options={roles.map((role) => ({
          value: role.toLowerCase().replaceAll(" ", "-"),
          label: role,
        }))}
      />
      <TextField
        id="volunteer-availability"
        name="availability"
        label="Availability"
        hint="Share when you may be available."
        required
      />
      <TextArea
        id="volunteer-message"
        name="message"
        label="Short message"
        hint="Tell us briefly about your interest in volunteering."
        required
      />
      <Checkbox
        id="volunteer-consent"
        name="consent"
        hint="We use this information to review and respond to your application."
        required
      >
        I agree that EAZY-IRA may use this information to respond to my
        application under its <a href="/legal/privacy">Privacy Policy</a>.
      </Checkbox>
    </FormShell>
  </Section>
</BaseLayout>
