---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import SiteSearch from "../components/SiteSearch.astro";
import { t } from "../i18n";
---

<BaseLayout
  title={t("notFoundTitle")}
  description={t("notFoundBody")}
  robots="noindex, nofollow"
  robots="noindex, nofollow"
>
  <section class="not-found-page">
    <Container>
      <p class="ui-section__eyebrow">{t("notFoundTitle")}</p>
      <h1>{t("notFoundHeading")}</h1>
      <p>{t("notFoundBody")}</p>
      <SiteSearch id="not-found-search" />
      <nav aria-label={t("helpfulLinks")}>
        <a href="/">{t("home")}</a>
        <a href="/about">{t("aboutFoundation")}</a>
        <a href="/programs">{t("programs")}</a>
        <a href="/contact">{t("contactUsTitle")}</a>
      </nav>
    </Container>
  </section>
</BaseLayout>
