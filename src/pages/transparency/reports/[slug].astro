---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const formatRWF = (amount: number) =>
  `${amount.toLocaleString("en")} RWF`;

export async function getStaticPaths() {
  const reports = await getCollection("reports");

  return reports.map((report) => {
    const itemTotal = report.data.items.reduce(
      (total, item) => total + item.costRWF,
      0,
    );

    if (itemTotal !== report.data.amountReceivedRWF) {
      console.warn(
        `[transparency] "${report.data.title}" does not reconcile: items total ${itemTotal} RWF, received ${report.data.amountReceivedRWF} RWF.`,
      );
    }

    return {
      params: { slug: report.id },
      props: { report, itemTotal },
    };
  });
}

const { report, itemTotal } = Astro.props;
const reconciled = itemTotal === report.data.amountReceivedRWF;
const donorMayBeShown =
  report.data.donorPermissionConfirmed && report.data.donorDisplayName;
const reportType = report.data.type.replaceAll("-", " ");
---

<BaseLayout
  title={`${report.data.title} | Transparency`}
  description={`Itemized ${reportType} from EAZY-IRA Charity Foundation.`}
>
  <section class="report-hero">
    <div class="report-container">
      <a class="back-link" href="/transparency">← Back to transparency</a>
      <p class="eyebrow">Financial report · {reportType}</p>
      <h1>{report.data.title}</h1>
      <p class="report-date">Date: {report.data.date}</p>
      {donorMayBeShown && <p>Donor: {report.data.donorDisplayName}</p>}
    </div>
  </section>

  <section class="report-section" aria-labelledby="breakdown-heading">
    <div class="report-container">
      <header class="section-header">
        <h2 id="breakdown-heading">Itemized spending</h2>
        <p>
          Amount received: <strong>{formatRWF(report.data.amountReceivedRWF)}</strong>
        </p>
      </header>

      <ul class="item-list">
        {
          report.data.items.map((entry) => (
            <li class="item-card">
              <div class="item-details">
                <div>
                  <h3>{entry.item}</h3>
                  <p>Quantity: {entry.quantity}</p>
                </div>
                <p class="item-cost">{formatRWF(entry.costRWF)}</p>
              </div>
              <figure class="receipt-slot">
                {entry.receiptImage ? (
                  <img
                    src={entry.receiptImage}
                    alt={`Receipt image placeholder for ${entry.item}`}
                    loading="lazy"
                    width="640"
                    height="360"
                  />
                ) : (
                  <div class="receipt-missing" role="img" aria-label={`Receipt image not provided for ${entry.item}`}>
                    Receipt image not provided
                  </div>
                )}
                <figcaption>Receipt image placeholder</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>

      <div class="total-card">
        <span>Item total</span>
        <strong>{formatRWF(itemTotal)}</strong>
      </div>
      {
        reconciled ? (
          <p class="reconciled-badge" role="status">Reconciled</p>
        ) : (
          <p class="reconciliation-warning" role="status">
            This report does not reconcile: the item total differs from the amount
            received.
          </p>
        )
      }
      <p class="report-notes">{report.data.notes}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .report-hero {
    padding-block: clamp(3rem, 7vw, 5rem);
    background: var(--surface-card);
  }

  .report-container {
    width: calc(100% - var(--container-gutter) - var(--container-gutter));
    max-width: 72rem;
    margin-inline: auto;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: var(--type-sm);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .eyebrow {
    margin-bottom: 0.75rem;
    color: var(--brand-primary);
    font-size: var(--type-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    font-size: var(--type-3xl);
  }

  h2 {
    font-size: var(--type-2xl);
  }

  .report-date {
    margin-top: 1rem;
    color: var(--text-muted);
  }

  .report-section {
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-bottom: 2rem;
  }

  .section-header p {
    color: var(--text-muted);
  }

  .item-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item-card {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card-token);
    background: var(--surface-card);
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .item-details {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .item-details h3 {
    font-family: inherit;
    font-size: var(--type-lg);
  }

  .item-details p {
    margin-top: 0.25rem;
    color: var(--text-muted);
    font-size: var(--type-sm);
  }

  .item-details .item-cost {
    color: var(--text-primary);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .receipt-slot {
    max-width: 26rem;
    margin: 1.25rem 0 0;
  }

  .receipt-slot img,
  .receipt-missing {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px dashed var(--border-subtle);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--brand-primary) 5%, var(--surface-page));
    object-fit: cover;
  }

  .receipt-missing {
    display: grid;
    place-items: center;
    padding: 1rem;
    color: var(--text-muted);
    text-align: center;
  }

  .receipt-slot figcaption {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: var(--type-xs);
  }

  .total-card {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 2px solid var(--border-subtle);
    margin-top: 2rem;
    padding-top: 1rem;
  }

  .total-card strong {
    font-variant-numeric: tabular-nums;
  }

  .reconciled-badge,
  .reconciliation-warning {
    display: inline-flex;
    margin-top: 1.25rem;
    border-radius: var(--radius-control-token);
    padding: 0.45rem 0.9rem;
    font-size: var(--type-sm);
    font-weight: 700;
  }

  .reconciled-badge {
    background: color-mix(in srgb, #197347 14%, var(--surface-page));
    color: #155c3b;
  }

  .reconciliation-warning {
    border: 1px solid #9a5a00;
    background: color-mix(in srgb, #f2bc4b 20%, var(--surface-page));
    color: var(--text-primary);
  }

  .report-notes {
    margin-top: 1.5rem;
    color: var(--text-muted);
  }
</style>
