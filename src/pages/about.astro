---
import AboutPage from "../components/AboutPage.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import Section from "../components/ui/Section.astro";
import impact from "../data/impact.json";
import site from "../data/site.json";
import { t } from "../i18n";
---

<AboutPage
  title={t("aboutTitle")}
  description={t("aboutDescription")}
  activePath="/about"
>
  <Section
    eyebrow={t("ourStory")}
    heading={t("storyHeading")}
    intro={t("storyIntroAbout")}
  >
    <div class="about-story">
      <p>
        {t("aboutStoryFirst", "en", {
          month: impact.foundedMonth,
          year: impact.foundedYear,
          founders: impact.founders,
        })}
      </p>
      <p>
        {t("aboutStorySecond")}
      </p>
    </div>
  </Section>

  <Section
    eyebrow={t("whatWeDo")}
    heading={t("wholeDevelopment")}
    intro={t("whatWeDoIntro")}
  >
    <Card class="about-summary">
      <p>
        {t("aboutSummary", "en", { location: site.location })}
      </p>
      <Button variant="secondary" href="/about/vision-mission">
        {t("readVision")}
      </Button>
    </Card>
  </Section>
</AboutPage>

<style>
  .about-story {
    display: grid;
    max-width: 54rem;
    gap: 1.25rem;
  }

  .about-summary {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }
</style>
