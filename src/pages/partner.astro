---
import BaseLayout from "../layouts/BaseLayout.astro";
import Checkbox from "../components/forms/Checkbox.astro";
import EmailField from "../components/forms/EmailField.astro";
import FormShell from "../components/forms/FormShell.astro";
import Select from "../components/forms/Select.astro";
import TextArea from "../components/forms/TextArea.astro";
import TextField from "../components/forms/TextField.astro";
import Section from "../components/ui/Section.astro";
import { t } from "../i18n";
---

<BaseLayout
  title="Partner"
  description="Explore partnership with EAZY-IRA Charity Foundation."
>
  <Section
    eyebrow="Work together"
    heading="Partner with EAZY-IRA"
    intro="We welcome partnership conversations with churches, businesses, NGOs, and professionals who share a commitment to supporting children and families."
    headingLevel="h1"
  >
    <p class="partnership-download">
      <a
        href="/documents/partnership-development-vision-placeholder.pdf"
        download
      >
        {t("downloadPartnershipVision")}
      </a>
    </p>
  </Section>

  <Section eyebrow="Start a conversation" heading="Partnership enquiry">
    <FormShell name="partnership-enquiry" submitLabel={t("sendEnquiry")}>
      <TextField
        id="partner-organisation"
        name="organisation"
        label={t("fieldOrganisation")}
        hint={t("partnerOrganisationHint")}
        required
      />
      <TextField
        id="partner-contact"
        name="contact-person"
        label={t("fieldContactPerson")}
        hint={t("partnerContactHint")}
        autocomplete="name"
        required
      />
      <EmailField
        id="partner-email"
        name="email"
        label={t("fieldEmail")}
        hint={t("partnerEmailHint")}
        required
      />
      <TextField
        id="partner-phone"
        name="phone"
        label={t("fieldPhoneOptional")}
        hint={t("contactPhoneHint")}
        type="tel"
        autocomplete="tel"
      />
      <Select
        id="partner-type"
        name="partnership-type"
        label={t("fieldPartnershipType")}
        hint={t("partnerTypeHint")}
        required
        options={[
          { value: "church", label: t("church") },
          { value: "business", label: t("business") },
          { value: "ngo", label: t("ngo") },
          { value: "professional", label: t("professional") },
        ]}
      />
      <TextArea
        id="partner-message"
        name="message"
        label={t("fieldMessage")}
        hint={t("partnerMessageHint")}
        required
      />
      <Checkbox
        id="partner-consent"
        name="consent"
        hint={t("partnerConsentHint")}
        required
      >
        {t("partnerConsentIntro")}{" "}
        <a href="/legal/privacy">{t("privacyPolicy")}</a>.
      </Checkbox>
    </FormShell>
  </Section>
</BaseLayout>
