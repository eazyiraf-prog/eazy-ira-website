---
import BaseLayout from "../layouts/BaseLayout.astro";
import Checkbox from "../components/forms/Checkbox.astro";
import EmailField from "../components/forms/EmailField.astro";
import FormShell from "../components/forms/FormShell.astro";
import TextArea from "../components/forms/TextArea.astro";
import TextField from "../components/forms/TextField.astro";
import Section from "../components/ui/Section.astro";
import site from "../data/site.json";
import { t } from "../i18n";
---

<BaseLayout
  title={t("contactPageTitle")}
  description={t("contactDescription")}
>
  <Section
    id="contact"
    headingLevel="h1"
    eyebrow={t("getInTouch")}
    heading={t("contactHeading")}
    intro={t("contactIntro")}
  >
    <div class="contact-details">
      <p><strong>{t("locationLabel")}</strong> {site.location}</p>
      <p>
        <strong>{t("emailLabel")}</strong>{" "}
        {site.email.needsConfirmation
          ? "[to be confirmed]"
          : <a href={`mailto:${site.email.value}`}>{site.email.value}</a>}
      </p>
      <p>
        <strong>{t("phoneLabel")}</strong>{" "}
        {site.phone.needsConfirmation
          ? "[to be confirmed]"
          : site.phone.value}
      </p>
    </div>
  </Section>

  <Section eyebrow={t("ourLocation")} heading={t("findMasoro")}>
    <div class="map-placeholder" data-map-placeholder>
      <p>
        {t("mapPrivacyText")}
      </p>
      <button
        class="ui-button ui-button--secondary"
        type="button"
        data-load-map
        data-map-title={t("mapTitle")}
      >
        {t("loadMap")}
      </button>
    </div>
  </Section>

  <Section
    eyebrow={t("sendMessageSection")}
    heading={t("contactForm")}
  >
    <FormShell name="contact" submitLabel={t("sendMessage")}>
      <TextField
        id="contact-name"
        name="name"
        label={t("fieldName")}
        hint={t("contactNameHint")}
        autocomplete="name"
        required
      />
      <EmailField
        id="contact-email"
        name="email"
        label={t("fieldEmail")}
        hint={t("contactEmailHint")}
        required
      />
      <TextField
        id="contact-phone"
        name="phone"
        label={t("fieldPhoneOptional")}
        hint={t("contactPhoneHint")}
        type="tel"
        autocomplete="tel"
      />
      <TextField
        id="contact-subject"
        name="subject"
        label={t("fieldSubject")}
        hint={t("contactSubjectHint")}
        required
      />
      <TextArea
        id="contact-message"
        name="message"
        label={t("fieldMessage")}
        hint={t("sensitiveInfoHint")}
        required
      />
      <Checkbox
        id="contact-consent"
        name="consent"
        hint={t("contactConsentHint")}
        required
      >
        {t("contactConsentIntro")}{" "}
        <a href="/legal/privacy">{t("privacyPolicy")}</a>.
      </Checkbox>
    </FormShell>
  </Section>
</BaseLayout>

<script>
  const mapPlaceholder = document.querySelector<HTMLElement>(
    "[data-map-placeholder]",
  );
  const loadMapButton = mapPlaceholder?.querySelector<HTMLButtonElement>(
    "[data-load-map]",
  );

  loadMapButton?.addEventListener("click", () => {
    if (!mapPlaceholder) return;

    const iframe = document.createElement("iframe");
    iframe.title = loadMapButton?.dataset.mapTitle ?? "";
    iframe.loading = "lazy";
    iframe.referrerPolicy = "no-referrer";
    iframe.src = `https://www.google.com/maps?q=${encodeURIComponent("Masoro, Kigali, Rwanda")}&output=embed`;
    mapPlaceholder.replaceChildren(iframe);
  });
</script>
