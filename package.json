{
  "name": "eazy-ira-charity-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/validate-donation.js && node scripts/check-i18n.js",
    "build": "astro build && pagefind --site dist && node scripts/update-csp.js",
    "build:prod": "node scripts/validate-donation.js --production && node scripts/check-i18n.js && astro build && pagefind --site dist && node scripts/update-csp.js",
    "preview": "astro preview",
    "test:worker": "node --test worker/index.test.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^1.2.2",
    "globals": "^17.14.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.160.0"
  }
}
